# Embeds files as byte arrays in a generated C++ source (the XGI console and the XI web page).
#   cmake -DROOT=<dir> -DFILES=a.html,b.css,c.css=/other/dir/c.css -DOUT=<file.cpp>
#         -DNAMESPACE=xgi::ui -DHEADER=xgi/ui_assets.hpp -P EmbedAssets.cmake
# Each entry is a file under ROOT, or "<served name>=<path>" for a file elsewhere.
if(NOT NAMESPACE)
    set(NAMESPACE "xgi::ui")
endif()
if(NOT HEADER)
    set(HEADER "xgi/ui_assets.hpp")
endif()
string(REPLACE "," ";" files "${FILES}")
string(REPEAT "[0-9a-f]" 48 row)  # 24 bytes per line keeps the generated lines short
set(arrays "")
set(table "")
set(i 0)
foreach(entry IN LISTS files)
    if(entry MATCHES "^([^=]+)=(.+)$")
        set(f "${CMAKE_MATCH_1}")
        set(src "${CMAKE_MATCH_2}")
    else()
        set(f "${entry}")
        set(src "${ROOT}/${entry}")
    endif()
    file(READ "${src}" hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR size "${hexlen} / 2")
    string(REGEX REPLACE "(${row})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND arrays "const unsigned char data${i}[] = {\n${bytes}0x00};\n\n")
    string(APPEND table "    {\"${f}\", data${i}, ${size}},\n")
    math(EXPR i "${i} + 1")
endforeach()

set(content "// Generated by cmake/EmbedAssets.cmake. Do not edit.
#include \"${HEADER}\"

namespace ${NAMESPACE} {
namespace {

${arrays}const Asset assets[] = {
${table}};

}  // namespace

const Asset* find_asset(std::string_view path) {
    for (const auto& a : assets)
        if (path == a.path) return &a;
    return nullptr;
}

}  // namespace ${NAMESPACE}
")
# Only touch the output when it changes, so unrelated rebuilds stay incremental.
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${content}")
